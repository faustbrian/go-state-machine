        "responsibility": "Provide deterministic typed state-machine compilation, transition selection, inert effect planning, replay and evolution, with optional explicit execution, persistence, outbox delivery, and diagram rendering.",
        "non_goals": [
          "Own durable workflow scheduling, timers, activities, retries, distributed compensation, or recovery orchestration.",
          "Execute effects, perform persistence, or acquire application resources implicitly from the core package.",
          "Provide a rule engine, queue, saga framework, or dependency-injection container."
        ],
        "public_package_identifier": "statemachine",
        "primary_entry_packages": [
          "github.com/faustbrian/go-state-machine"
        ],
        "package_selection": {
          "github.com/faustbrian/go-state-machine": "Use to compile typed finite-state definitions into immutable machines, select transitions, plan inert effects, replay inputs, and validate or evolve history.",
          "github.com/faustbrian/go-state-machine/diagram": "Use to render a compiled machine graph as bounded Mermaid or Graphviz output.",
          "github.com/faustbrian/go-state-machine/memory": "Use for concurrency-safe ephemeral state-machine persistence in tests, development, or non-durable processes.",
          "github.com/faustbrian/go-state-machine/outbox": "Use to relay persisted state-machine effects with explicit leases, failure classification, and at-least-once delivery.",
          "github.com/faustbrian/go-state-machine/postgres": "Use for durable PostgreSQL state, history, snapshots, optimistic transitions, and atomic outbox insertion.",
          "github.com/faustbrian/go-state-machine/runner": "Use to execute an inert effect plan explicitly with ordered handling, cancellation, panic containment, and outcome recording.",
          "github.com/faustbrian/go-state-machine/statemachinetest": "Use to verify custom Store and effect-runner implementations against reusable conformance contracts."
